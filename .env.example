# Configuração do orquestrador (prefixo ORQ_). Copie para .env e ajuste.
ORQ_PROJECTS_FILE=projects.yml
ORQ_DATA_DIR=.orquestrador
ORQ_MAX_PARALLEL_JOBS=2
ORQ_MAX_CONCURRENT_RUNS=2
ORQ_KEEP_WORKSPACES=false

# Execução: local (subprocess) ou docker (container por job)
ORQ_EXECUTOR=local
ORQ_DOCKER_DEFAULT_IMAGE=python:3.11-slim

# Despacho: thread (no processo da API) ou rq (fila Redis + workers)
ORQ_DISPATCHER=thread
ORQ_REDIS_URL=redis://localhost:6379/0
ORQ_QUEUE_NAME=orquestrador
ORQ_RUN_TIMEOUT=10800

# Segredos referenciados em projects.yml
GITHUB_WEBHOOK_SECRET=troque-este-segredo
GITLAB_WEBHOOK_TOKEN=troque-este-token
